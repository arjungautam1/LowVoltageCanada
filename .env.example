# Public identifiers for the existing Sanity project. Clear the ID for demo mode.
NEXT_PUBLIC_SANITY_PROJECT_ID=via74ij9
NEXT_PUBLIC_SANITY_DATASET=production

# Canonical production origin. On Vercel, its production domain is used automatically.
# Set this when you connect your final custom domain, without a path or trailing parameters.
NEXT_PUBLIC_SITE_URL=

# Optional Search Console / Bing verification codes (public, not API credentials).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# EmailJS credentials for contact form
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_v3ctqrx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_bnqm3fw
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=HTaYQ42Dzhx8695R7
